"""Run every candidate tier on the same shots and save per-shot correctness, time and BP features.

  python experiments/collect.py --p 0.004 --shots 1500 --seed 11 --out data/p0.004_s11.npz

One row per (basis, shot). Downstream scripts simulate any routing policy from this table
without re-decoding.
"""
import argparse
import os
import sys
import time
from multiprocessing import Pool
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "kit"))
from ldpc import BpDecoder, BpLsdDecoder  # noqa: E402

from circuit import GROSS_CIRCUITS, dem_matrices, detector_ids, load_circuit, sample  # noqa: E402
from decoders import bposd_decoder, relay_decoder  # noqa: E402

LIGHT_ITERS = 80
TIERS = ["bp", "lsd", "bposd", "relay_fast", "relay"]


def build(H, priors):
    common = dict(error_channel=list(priors), bp_method="minimum_sum", ms_scaling_factor=1.0)
    return {
        "bp": BpDecoder(H, max_iter=LIGHT_ITERS, **common),
        "lsd": BpLsdDecoder(H, max_iter=LIGHT_ITERS, lsd_order=0, **common),
        "bposd": bposd_decoder(H, priors),
        "relay_fast": relay_decoder(H, priors, stop_nconv=1, num_sets=50),
        "relay": relay_decoder(H, priors),
    }


def features(bp, H, priors, syndrome, error):
    llr = np.asarray(bp.log_prob_ratios)
    abs_llr = np.abs(llr)
    weights = np.log((1 - priors) / priors)
    return [
        float(bp.converge), float(bp.iter), float(syndrome.sum()), float(error.sum()),
        float(weights @ error), float(abs_llr.min()), float((abs_llr < 1).sum()),
        float((abs_llr < 3).sum()), float(((H @ error) % 2 != syndrome).sum()),
    ]


BP_FEATURES = ["converged", "iters", "syndrome_wt", "correction_wt", "correction_cost",
               "min_abs_llr", "n_llr_lt1", "n_llr_lt3", "residual_wt"]
RELAY_FEATURES = ["rf_success", "rf_iters", "rf_weight", "rf_cost", "rf_min_abs_post", "rf_n_post_lt1"]
FEATURE_NAMES = BP_FEATURES + RELAY_FEATURES
N_BP = len(BP_FEATURES)


def relay_features(result, priors, error):
    """Diagnostics of the fast Relay-BP run: did it stop on a solution, how long it searched, how costly it is."""
    post = np.abs(np.log(np.clip(np.asarray(result.posterior_ratios, float), 1e-300, None)))
    weights = np.log((1 - priors) / priors)
    return [float(result.success), float(result.iterations), float(error.sum()), float(weights @ error),
            float(post.min()), float((post < 1).sum())]


def work(job):
    basis, p, det, obs = job
    circuit = load_circuit(GROSS_CIRCUITS[basis], p)
    H, L, priors = dem_matrices(circuit, basis)
    decs = build(H, priors)
    n = len(det)
    correct = np.zeros((n, len(TIERS)), bool)
    seconds = np.zeros((n, len(TIERS)))
    feats = np.zeros((n, len(FEATURE_NAMES)))
    for k in range(n):
        for j, name in enumerate(TIERS):
            start = time.perf_counter()
            if name == "relay_fast":
                result = decs[name].decode_detailed(det[k])
                error = np.asarray(result.decoding, np.uint8)
            else:
                error = np.asarray(decs[name].decode(det[k]), np.uint8)
            seconds[k, j] = time.perf_counter() - start
            correct[k, j] = not ((L @ error) % 2 != obs[k]).any()
            if name == "bp":
                feats[k, :N_BP] = features(decs["bp"], H, priors, det[k], error)
            elif name == "relay_fast":
                feats[k, N_BP:] = relay_features(result, priors, error)
    return correct, seconds, feats


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--p", type=float, default=0.004)
    ap.add_argument("--shots", type=int, default=1500)
    ap.add_argument("--seed", type=int, default=11)
    ap.add_argument("--workers", type=int, default=os.cpu_count())
    ap.add_argument("--out", required=True)
    args = ap.parse_args()

    jobs, basis_col = [], []
    for b, basis in enumerate("XZ"):
        circuit = load_circuit(GROSS_CIRCUITS[basis], args.p)
        det, obs = sample(circuit, args.shots, args.seed + b)
        det = det[:, detector_ids(circuit, basis)]
        for chunk in np.array_split(np.arange(args.shots), args.workers):
            jobs.append((basis, args.p, det[chunk], obs[chunk]))
            basis_col.append(np.full(len(chunk), b))
    start = time.time()
    with Pool(args.workers) as pool:
        results = pool.map(work, jobs)
    correct, seconds, feats = (np.concatenate(x) for x in zip(*results))
    Path(args.out).parent.mkdir(parents=True, exist_ok=True)
    np.savez_compressed(args.out, correct=correct, seconds=seconds, features=feats,
                        basis=np.concatenate(basis_col), tiers=TIERS, feature_names=FEATURE_NAMES,
                        p=args.p, shots=args.shots, seed=args.seed)
    print(f"{args.out}: {len(correct)} rows in {time.time() - start:.0f} s")
    for j, name in enumerate(TIERS):
        print(f"  {name:10s} wrong {(~correct[:, j]).sum():4d}  mean {seconds[:, j].mean() * 1e3:7.1f} ms  "
              f"p99 {np.percentile(seconds[:, j], 99) * 1e3:7.0f} ms")


if __name__ == "__main__":
    main()
"""Simulate routing policies on a table from collect.py, scored as in the kit.

  python experiments/analyze.py data/p0.004_s11.npz

A pair (X shot k, Z shot k) fails when either fails; its time is the sum. Cascade time is
the light BP time plus the fallback's time when the shot is escalated (cold fallback).
The ML gate is trained on the first half of the pairs and evaluated on the second half.
"""
import sys

import numpy as np
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler

CYCLES = 12


def per_cycle(failed_pairs):
    P = failed_pairs.mean()
    hi = P + 1.96 * np.sqrt(max(P * (1 - P), 1 / len(failed_pairs)) / len(failed_pairs))
    return 1 - (1 - P) ** (1 / CYCLES), 1 - (1 - min(hi, 1)) ** (1 / CYCLES)


def pairs(a, basis):
    """Reshape a per-row array into (shot, basis)."""
    return np.stack([a[basis == 0], a[basis == 1]], axis=1)


def report(name, wrong, secs, escalated=None):
    fail = wrong.any(axis=1)
    ms = secs.sum(axis=1) * 1e3
    rate, hi = per_cycle(fail)
    esc = f"  escalated {escalated.mean():5.1%}" if escalated is not None else ""
    print(f"{name:34s} pair fails {fail.sum():4d}/{len(fail)}  LER/cycle {rate:.2e} (95% hi {hi:.1e})  "
          f"mean {ms.mean():7.1f} ms  p50 {np.median(ms):6.1f}  p99 {np.percentile(ms, 99):7.0f} ms{esc}")


def main(path):
    d = np.load(path, allow_pickle=True)
    tiers = list(d["tiers"])
    names = list(d["feature_names"])
    basis = d["basis"]
    C = {t: pairs(d["correct"][:, i], basis) for i, t in enumerate(tiers)}
    S = {t: pairs(d["seconds"][:, i], basis) for i, t in enumerate(tiers)}
    F = np.stack([d["features"][basis == 0], d["features"][basis == 1]], axis=1)  # shot, basis, feature
    conv = F[..., names.index("converged")] == 1
    corr_wt = F[..., names.index("correction_wt")]

    n = len(conv)
    test = np.arange(n) >= n // 2
    print(f"{path}: p={float(d['p'])}, {n} pairs; test half = {test.sum()} pairs\n")
    print(f"BP-80 converged: {conv.mean():.1%} of shots; wrong when converged: "
          f"{(~C['bp'][conv]).sum()} of {conv.sum()}")
    print(f"correction weight of converged BP: median {np.median(corr_wt[conv]):.0f}, "
          f"fraction <= 4: {(corr_wt[conv] <= 4).mean():.1%}\n")

    def cascade(accept, fallback):
        wrong = np.where(accept, ~C["bp"], ~C[fallback])
        secs = S["bp"] + np.where(accept, 0.0, S[fallback])
        return wrong, secs, ~accept

    # ML gate for escalated shots: predict whether relay_fast is enough, else full relay.
    X = np.concatenate([F.reshape(-1, F.shape[-1]), np.tile([[0], [1]], (n, 1))], axis=1)
    y = ~C["relay_fast"].reshape(-1) & C["relay"].reshape(-1)   # fast tier would hurt
    tr = np.repeat(~test, 2) & ~conv.reshape(-1)
    risk = np.zeros(2 * n)
    if y[tr].sum() >= 3:
        model = make_pipeline(StandardScaler(), LogisticRegression(class_weight="balanced", max_iter=2000))
        model.fit(X[tr], y[tr])
        risk = model.predict_proba(X)[:, 1]
    risk = risk.reshape(n, 2)
    print(f"training shots where relay_fast fails but relay succeeds: {int(y[tr].sum())}\n")

    for label, mask in [("ALL PAIRS", np.ones(n, bool)), ("TEST HALF", test)]:
        print(f"--- {label} ---")
        sel = lambda a: a[mask]  # noqa: E731
        for t in ["bposd", "relay", "relay_fast", "lsd"]:
            report(f"{t} alone", sel(~C[t]), sel(S[t]))
        for fb in ["relay", "relay_fast", "lsd"]:
            w, s, e = cascade(conv, fb)
            report(f"BP-80 conv-gate -> {fb}", sel(w), sel(s), sel(e))
        w, s, e = cascade(conv & (corr_wt <= 4), "relay")
        report("gate + weight<=4 rule -> relay", sel(w), sel(s), sel(e))
        # 3-tier: converged -> accept; else ML picks relay_fast or relay.
        for thr in (0.5, 0.2):
            heavy = ~conv & (risk >= thr)
            fast = ~conv & ~heavy
            wrong = np.where(conv, ~C["bp"], np.where(fast, ~C["relay_fast"], ~C["relay"]))
            secs = S["bp"] + np.where(fast, S["relay_fast"], 0) + np.where(heavy, S["relay"], 0)
            report(f"3-tier ML (thr {thr}) heavy {sel(heavy).mean():.0%}", sel(wrong), sel(secs), sel(~conv))
        oracle_fast = ~conv & C["relay_fast"]
        wrong = np.where(conv, ~C["bp"], np.where(oracle_fast, False, ~C["relay"]))
        secs = S["bp"] + np.where(oracle_fast, S["relay_fast"], np.where(conv, 0, S["relay"]))
        report("3-tier ORACLE router", sel(wrong), sel(secs), sel(~conv))
        print()


if __name__ == "__main__":
    main(sys.argv[1])
"""Confidence-based escalation: fast Relay-BP first, a learned gate decides whether to also run full Relay-BP.

  python experiments/escalate.py data/v2_p0.004.npz [more files...]

Policy per shot: run relay_fast (its first leg is an 80-iteration BP, so easy shots stop there).
A logistic-regression gate on its diagnostics predicts P(relay_fast is wrong). Above the threshold
the shot is escalated to full Relay-BP, whose answer replaces it; the time is relay_fast + relay.

Pairs are split 50 / 25 / 25 into train / validation / test. The threshold is chosen on validation as
the fastest one whose pair-failure count is within `--slack` of Relay-BP alone; test numbers are reported.
"""
import argparse
import json

import numpy as np
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler

CYCLES = 12
GATE_FEATURES = ["rf_success", "rf_iters", "rf_weight", "rf_cost", "rf_min_abs_post", "rf_n_post_lt1",
                 "syndrome_wt"]


def per_cycle(fail):
    return 1 - (1 - fail.mean()) ** (1 / CYCLES)


def by_pair(a, basis):
    return np.stack([a[basis == 0], a[basis == 1]], axis=1)


def summary(wrong, secs):
    fail = wrong.any(axis=1)
    ms = secs.sum(axis=1) * 1e3
    return dict(fails=int(fail.sum()), n=len(fail), ler=per_cycle(fail), mean_ms=ms.mean(),
                p50_ms=float(np.median(ms)), p99_ms=float(np.percentile(ms, 99)))


def line(name, s, extra=""):
    return (f"{name:30s} fails {s['fails']:4d}/{s['n']}  LER/cycle {s['ler']:.2e}  mean {s['mean_ms']:7.1f} ms  "
            f"p50 {s['p50_ms']:6.1f}  p99 {s['p99_ms']:6.0f}{extra}")


def analyse(path, slack):
    d = np.load(path, allow_pickle=True)
    tiers, names, basis = list(d["tiers"]), list(d["feature_names"]), d["basis"]
    C = {t: by_pair(d["correct"][:, i], basis) for i, t in enumerate(tiers)}
    S = {t: by_pair(d["seconds"][:, i], basis) for i, t in enumerate(tiers)}
    F = np.stack([d["features"][basis == 0], d["features"][basis == 1]], axis=1)
    n = F.shape[0]
    X = np.concatenate([F[..., [names.index(f) for f in GATE_FEATURES]],
                        np.broadcast_to(np.array([0.0, 1.0])[None, :, None], (n, 2, 1))], axis=2)
    split = np.arange(n) * 4 // n            # 0,1 train; 2 validation; 3 test
    train, val, test = split <= 1, split == 2, split == 3

    y = ~C["relay_fast"]
    model = make_pipeline(StandardScaler(), LogisticRegression(class_weight="balanced", C=0.5, max_iter=5000))
    model.fit(X[train].reshape(-1, X.shape[-1]), y[train].reshape(-1))
    risk = model.predict_proba(X.reshape(-1, X.shape[-1]))[:, 1].reshape(n, 2)

    def policy(escalate):
        wrong = np.where(escalate, ~C["relay"], ~C["relay_fast"])
        secs = S["relay_fast"] + np.where(escalate, S["relay"], 0.0)
        return wrong, secs

    thresholds = np.r_[0.0, np.quantile(risk[train], np.linspace(0.5, 0.999, 60)), 1.01]
    curve, target = [], (~C["relay"][val]).any(axis=1).sum() + slack
    for thr in thresholds:
        w, s = policy(risk >= thr)
        curve.append(dict(thr=float(thr), val=summary(w[val], s[val]), test=summary(w[test], s[test]),
                          escalated=float((risk[test] >= thr).mean())))
    ok = [c for c in curve if c["val"]["fails"] <= target]
    chosen = min(ok, key=lambda c: c["val"]["mean_ms"])

    # Gemini's deterministic alternative: escalate unless it succeeded within K iterations and cost <= W.
    succ = F[..., names.index("rf_success")] == 1
    iters, cost = F[..., names.index("rf_iters")], F[..., names.index("rf_cost")]
    grid = []
    for K in np.unique(np.quantile(iters[train & succ], np.linspace(0.5, 1, 11))):
        for W in np.quantile(cost[train], np.linspace(0.5, 1, 11)):
            w, s = policy(~succ | (iters > K) | (cost > W))
            grid.append(dict(K=float(K), W=float(W), val=summary(w[val], s[val]), test=summary(w[test], s[test])))
    grid_ok = [g for g in grid if g["val"]["fails"] <= target]
    det_rule = min(grid_ok, key=lambda g: g["val"]["mean_ms"])

    oracle_w, oracle_s = policy(y & C["relay"])            # escalate exactly the shots relay would fix
    rule_w, rule_s = policy(F[..., names.index("rf_success")] == 0)
    p = float(d["p"])
    out = {"p": p, "relay": summary(~C["relay"][test], S["relay"][test]),
           "bposd": summary(~C["bposd"][test], S["bposd"][test]),
           "relay_fast": summary(~C["relay_fast"][test], S["relay_fast"][test]),
           "rule": summary(rule_w[test], rule_s[test]), "oracle": summary(oracle_w[test], oracle_s[test]),
           "ml": chosen["test"], "ml_thr": chosen["thr"], "ml_escalated": chosen["escalated"],
           "det_rule": det_rule["test"], "det_rule_KW": [det_rule["K"], det_rule["W"]],
           "curve": [dict(thr=c["thr"], escalated=c["escalated"], **c["test"]) for c in curve]}

    print(f"\n{path}  p={p}  test pairs={test.sum()}  (gate trained on {train.sum()} pairs)")
    print(line("BP-OSD (kit)", out["bposd"]))
    print(line("Relay-BP (kit)", out["relay"]))
    print(line("Relay-fast alone", out["relay_fast"]))
    print(line("rule: escalate if no solution", out["rule"]))
    print(line("ML gate", out["ml"], f"  thr {chosen['thr']:.3f} escalated {chosen['escalated']:.1%}"))
    print(line("rule: iters<=K & cost<=W", out["det_rule"], f"  K={det_rule['K']:.0f} W={det_rule['W']:.0f}"))
    print(line("oracle gate", out["oracle"]))
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("files", nargs="+")
    ap.add_argument("--slack", type=int, default=0, help="extra validation pair failures allowed vs Relay-BP")
    ap.add_argument("--json", default="results/escalate.json")
    args = ap.parse_args()
    results = [analyse(f, args.slack) for f in args.files]
    import os
    os.makedirs(os.path.dirname(args.json), exist_ok=True)
    with open(args.json, "w") as fh:
        json.dump(results, fh, indent=1)
    print(f"\nwrote {args.json}")


if __name__ == "__main__":
    main()

